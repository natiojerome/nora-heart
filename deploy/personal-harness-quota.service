[Unit]
Description=Heart read-only account quota collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=personal-harness
WorkingDirectory=/projects/nora-heart
Environment=GOMAXPROCS=2
EnvironmentFile=/etc/personal-harness/quota.env
ExecStart=/projects/nora-heart/.tools/node-v24.22.3-linux-x64/bin/node /projects/nora-heart/node_modules/tsx/dist/cli.mjs /projects/nora-heart/src/interfaces/account-quota.ts
StateDirectory=personal-harness-quota
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/personal-harness-quota
MemoryMax=192M
CPUQuota=25%
TasksMax=32
TimeoutStartSec=30
