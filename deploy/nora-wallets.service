[Unit]
Description=Nora local wallets (Unix socket, offline signing)
After=network-online.target
Wants=network-online.target

[Service]
User=nora-wallets
Group=nora-wallets
WorkingDirectory=/projects/nora-heart
ExecStart=/projects/nora-heart/.tools/node-v24.22.3-linux-x64/bin/node /projects/nora-heart/node_modules/tsx/dist/cli.mjs /projects/nora-heart/src/interfaces/wallets.ts daemon
LoadCredentialEncrypted=master:/etc/nora-wallets/master.cred
StateDirectory=nora-wallets
StateDirectoryMode=0700
RuntimeDirectory=nora-wallets
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0

[Install]
WantedBy=multi-user.target
