# Reference only: inject through the shell, process manager or a secret store.
# The CLI does not load .env files automatically. Do not commit real credentials.
# PostgreSQL is selected by this URL when no driver is specified.
HARNESS_DATABASE_URL=
# Optional explicit selection for web: postgres or sqlite (no fallback).
# HARNESS_STORAGE_DRIVER=sqlite
# HARNESS_SQLITE_PATH=/private/heart.sqlite
# Optional: only needed when modules.model is explicitly ai-sdk.
HARNESS_OPENAI_API_KEY=
HARNESS_ANTHROPIC_API_KEY=
# Absolute path to a dedicated private directory (0700), outside the repository.
HARNESS_CHATGPT_AUTH_DIR=
# Optional web console; production uses a private systemd EnvironmentFile.
HARNESS_WEB_ORIGIN=https://heart.natio.re
HARNESS_WEB_HOST=127.0.0.1
HARNESS_WEB_STATE_DIR=
# Optional absolute path; defaults to <installation>/projects, separate from conversations.
# HARNESS_PROJECTS_ROOT=/srv/heart-projects
HARNESS_WEB_SESSION_SECRET=
HARNESS_WEB_INVITE_FILE=
# Optional permanent owner password; keep it in the private environment only.
HARNESS_WEB_PASSWORD=

# Optional OpenRouter provider; never commit a real key.
HARNESS_OPENROUTER_API_KEY=

# Optional read-only quota snapshot published by the separate account collector.
# The web process only receives this metadata path, never the source credentials.
HARNESS_QUOTA_SNAPSHOT_FILE=
HARNESS_QUOTA_MAX_AGE_MS=180000
# Collector-only private EnvironmentFile: HARNESS_QUOTA_SOURCE_FILE,
# HARNESS_QUOTA_HEART_ACCOUNT_FILE and HARNESS_QUOTA_SNAPSHOT_FILE.

# Optional remote authorities. IDs refer to approved MCP connections, not tokens.
# On the deployed MCP-backed installation both are explicitly configured.
# HARNESS_MEMORY_MCP_CONNECTION_ID=<connection-uuid>
# HARNESS_PROJECTS_MCP_CONNECTION_ID=<connection-uuid>
# NORA_MCPS_MEMORY_TOKEN= (inject privately)
# NORA_MCPS_PROJECTS_TOKEN= (inject privately)
# NORA_MCPS_VAULT_TOKEN= (inject privately)
